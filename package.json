{
  "name": "create-zhin",
  "version": "0.0.1",
  "description": "Setup a Zhin application",
  "bin": "lib/index.js",
  "scripts": {
    "start": "node .",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "ts-node-dev -r tsconfig-paths/register ./src/index.ts",
    "pub": "npm publish --access public",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/@zhinjs/create-zhin.git"
  },
  "keywords": [
    "ts",
    "dev",
    "template"
  ],
  "author": "凉菜",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/@zhinjs/create-zhin/issues"
  },
  "homepage": "https://github.com/@zhinjs/create-zhin#readme",
  "devDependencies": {
    "@types/tar": "^6.1.3",
    "@types/yargs-parser": "^21.0.0",
    "@types/node": "latest",
    "ts-node-dev": "latest",
    "tsc-alias": "latest",
    "tsconfig-paths": "latest",
    "typescript": "latest"
  },
  "files": [
    "/lib/**/*.js",
    "/lib/**/*.d.ts",
    "/lib/**/LICENSE"
  ],
  "dependencies": {
    "axios": "~1.1.3",
    "prompts": "^2.4.2",
    "tar": "^6.1.13",
    "yargs-parser": "^21.1.1"
  }
}
